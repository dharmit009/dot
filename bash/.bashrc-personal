# ============================================================================
# Kanagawa Truecolor Prompt Configuration (`~/.bashrc-personal`)
# ============================================================================
K_FUJI_WHITE='\[\e[38;2;220;215;186m\]'
K_FUJI_GRAY='\[\e[38;2;114;113;105m\]'
K_CRYSTAL_BLUE='\[\e[38;2;126;156;216m\]'
K_SPRING_BLUE='\[\e[38;2;127;180;202m\]'
K_SURIMI_ORANGE='\[\e[38;2;255;160;102m\]'
K_ONI_VIOLET='\[\e[38;2;149;127;184m\]'
K_SPRING_GREEN='\[\e[38;2;152;187;108m\]'
K_WAVE_RED='\[\e[38;2;228;104;118m\]'
K_RESET='\[\e[0m\]'

function set_virtualenv(){
    if test -z "$VIRTUAL_ENV" ; then
        PYTHON_VIRTUALENV=""
    else
        PYTHON_VIRTUALENV="${K_ONI_VIOLET}[$(basename "$VIRTUAL_ENV")]${K_RESET} "
    fi
}

__ps1() {
    local P='$' dir="${PWD##*/}" B short
    local r=$K_WAVE_RED
    local g=$K_FUJI_GRAY
    local h=$K_CRYSTAL_BLUE
    local u=$K_SURIMI_ORANGE
    local p=$K_SPRING_BLUE
    local w=$K_ONI_VIOLET
    local b=$K_SPRING_GREEN
    local x=$K_FUJI_WHITE

    [[ $EUID == 0 ]] && P='#' && u=$r
    [[ $PWD = / ]] && dir=/
    [[ $PWD = "$HOME" ]] && dir='~'

    # Handle git branch display cleanly
    B=$(git branch --show-current 2>/dev/null)
    [[ -n "$B" ]] && {
        [[ $B = master || $B = main ]] && b=$r
        B=" $b($B)$x"
    }

    set_virtualenv

    # Clean, artifact-free prompt layout: [user@host: dir] branch $
    short="$w$PYTHON_VIRTUALENV$r[$u\u$g@$h\h$g:$p$dir$r]$B$x$P "
    PS1="$short"
}

PROMPT_COMMAND="__ps1"
